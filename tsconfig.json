{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "frontend/src",
    "scripts",
    "tests"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "artifacts",
    "artifacts-zk",
    "typechain",
    "typechain-types",
    "cache"
  ]
}

